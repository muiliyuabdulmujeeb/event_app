# Database
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/eventdb
TEST_DATABASE_URL=postgresql+asyncpg://user:password@db:5432/eventdb_test

# Redis
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET=changeme
JWT_ACCESS_EXPIRY_HOURS=1
JWT_REFRESH_EXPIRY_DAYS=7

# Payment
ACTIVE_PAYMENT_GATEWAY=mock
PAYSTACK_SECRET_KEY=
SQUAD_SECRET_KEY=
MOCK_PAYMENT_BASE_URL=http://localhost:8000
PAYSTACK_API_BASE_URL=https://api.paystack.co
SQUAD_API_BASE_URL=
PAYMENT_CALLBACK_URL=
PAYSTACK_CHECKOUT_BASE_URL=https://checkout.paystack.com
SQUAD_CHECKOUT_BASE_URL=https://checkout.squadco.com
PAYMENT_TIMEOUT_MINUTES=30

# Email
EMAIL_PROVIDER=console
EMAIL_API_KEY=
